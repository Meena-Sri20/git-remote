services:
  web:
    image: nginx:latest
    ports:
      - "8086:80"
    networks:
      - app_net
    depends_on:
      - postgres
    restart: always
  postgres:
    image: postgres:latest
    container_name: db
    environment:
      POSTGRES_USER: demo
      POSTGRES_PASSWORD: demo
      POSTGRES_DB: demo_db
    volumes:
      - db_data:/var/lib/postgresql/db_data
    networks:
      - app_net
    restart: always
volumes:
  db_data:
networks:
  app_net:
